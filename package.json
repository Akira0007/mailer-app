{
  "name": "mailer-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"vite --port 5173\" \"tsc -p tsconfig.electron.json --watch\" \"wait-on http://localhost:5173 dist-electron/main/index.js && VITE_DEV_SERVER_URL=http://localhost:5173 electron dist-electron/main/index.js\"",
    "dev:renderer": "vite --port 5173",
    "dev:electron": "electron dist-electron/main/index.js",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "rebuild:native:mirror": "npm_config_disturl=https://npmmirror.com/mirrors/electron/ electron-rebuild -f -w better-sqlite3",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "tsc -b && pnpm build:electron && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "nodemailer": "^8.0.8",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.12.4",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^42.1.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10"
  }
}
